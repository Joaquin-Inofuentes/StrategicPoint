# ============ FORMULARIO DE LICENCIA DE UNITY ============
# 1) Copia este archivo:   cp licencia.env.plantilla licencia.env
# 2) Completa UNA de las dos opciones (A o B) y guarda.
# licencia.env esta en .gitignore: no se sube al repositorio.

# --- OPCION A: archivo .ulf (Unity Personal, gratis) -------------------
# Ruta al .ulf que te devuelve https://license.unity3d.com/manual
# despues de subir Unity_v6000.6.2f1.alf (ver LEEME.md)
UNITY_ULF=

# --- OPCION B: serie (Unity Pro / Plus / Enterprise) -------------------
UNITY_SERIAL=
UNITY_EMAIL=
UNITY_PASSWORD=
