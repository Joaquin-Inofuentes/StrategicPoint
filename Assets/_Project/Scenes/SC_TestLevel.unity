--- !u!114 &2076892640
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2076892638}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9, g: 0.9, b: 0.92, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 13
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "A PIE (FPS)\n[TAB] alternar entre vista FPS y vista t\xE1ctica RTS\n[WASD]
    moverse\n[Clic] disparar (mantener para fuego sostenido)\n[Mouse] mirar alrededor\n[R]
    recargar el arma\n[1][2][3] cambiar de arma: fusil, pistola, pesada\n[E] subir
    al veh\xEDculo cercano, o equipar el arma del piso\n[F] poseer al aliado al que
    est\xE1s apuntando\n[T] ordenarle al aliado libre m\xE1s cercano que vaya al
    punto apuntado\n[G] ordenarle al aliado m\xE1s cercano que suba al veh\xEDculo
    apuntado\n[Clic der.] zoom de mira (mantener)\n[Clic der.] mandar la camioneta
    al punto del suelo apuntado\n[Q] ciclar la posesi\xF3n al siguiente aliado vivo\n[C]
    poseer al aliado vivo m\xE1s cercano\n[F1][F2][F3] poseer directamente al soldado
    1, 2 o 3 de la escuadra\n[H] abrir y cerrar esta lista de controles sin pausar
    el juego\n[ESC] pausa y libera el cursor; dentro de los men\xFAs vuelve un paso
    atr\xE1s\n[Clic] capturar el cursor para poder mirar con el mouse\n\nVISTA T\xC1CTICA
    (RTS)\n[TAB] alternar entre vista FPS y vista t\xE1ctica RTS\n[WASD] panear la
    c\xE1mara\n[Clic] seleccionar al aliado o al veh\xEDculo bajo el cursor\n[F]
    poseer al aliado bajo el cursor, o tomar el mando del veh\xEDculo ocupado\n[T][Clic
    der.] mover la selecci\xF3n al punto, o atacar al enemigo se\xF1alado\n[G] subir
    la selecci\xF3n al veh\xEDculo se\xF1alado, o bajar a todos si ya est\xE1 ocupado\n[Arrastrar]
    seleccionar a todos los aliados del recuadro\n[Shift+Clic] sumar a la selecci\xF3n
    sin perder lo ya elegido\n[Ctrl+A] seleccionar a toda la escuadra viva\n[X] cancelar
    la orden de la selecci\xF3n y volver a patrullar\n[Espacio] recentrar la c\xE1mara
    en la escuadra\n[Rueda] acercar y alejar la c\xE1mara\n[Ctrl+1..9] guardar la
    selecci\xF3n como grupo de control\n[1..9] recuperar el grupo de control (doble
    toque: adem\xE1s lleva la c\xE1mara ah\xED)\n[Shift+Clic der.] encolar el destino
    detr\xE1s de las \xF3rdenes ya dadas\n[Clic der.] mantener: vista previa de la
    formaci\xF3n antes de soltar la orden\n[Q] ciclar la posesi\xF3n al siguiente
    aliado vivo\n[C] poseer al aliado vivo m\xE1s cercano\n[F1][F2][F3] poseer directamente
    al soldado 1, 2 o 3 de la escuadra\n[H] abrir y cerrar esta lista de controles
    sin pausar el juego\n[ESC] pausa y libera el cursor; dentro de los men\xFAs vuelve
    un paso atr\xE1s\n\nVEH\xCDCULO \u2014 CONDUCTOR\n[TAB] alternar entre vista
    FPS y vista t\xE1ctica RTS\n[WASD] conducir: acelerar, retroceder y girar\n[E]
    bajarse del veh\xEDculo\n[G] frenar (mantener)\n[2] pasar al asiento de artillero
    (si est\xE1 libre)\n[V] alternar c\xE1mara en primera persona / exterior\n[H]
    abrir y cerrar esta lista de controles sin pausar el juego\n[ESC] pausa y libera
    el cursor; dentro de los men\xFAs vuelve un paso atr\xE1s\n[Clic] capturar el
    cursor para poder mirar con el mouse\n\nVEH\xCDCULO \u2014 ARTILLERO\n[TAB] alternar
    entre vista FPS y vista t\xE1ctica RTS\n[Clic] disparar el ca\xF1\xF3n de la
    torreta\n[Mouse] girar la torreta hacia donde apunt\xE1s\n[R] alternar munici\xF3n
    explosiva / perforante\n[E] bajarse del veh\xEDculo\n[T] mandar el veh\xEDculo
    al punto del suelo que se\xF1al\xE1s\n[Clic der.] zoom de mira (mantener)\n[1]
    pasar al asiento de conductor (si est\xE1 libre)\n[V] alternar c\xE1mara en primera
    persona / exterior\n[H] abrir y cerrar esta lista de controles sin pausar el
    juego\n[ESC] pausa y libera el cursor; dentro de los men\xFAs vuelve un paso
    atr\xE1s\n[Clic] capturar el cursor para poder mirar con el mouse\n\nVEH\xCDCULO
    \u2014 PASAJERO\n[TAB] alternar entre vista FPS y vista t\xE1ctica RTS\n[E] bajarse
    del veh\xEDculo\n[V] alternar c\xE1mara en primera persona / exterior\n[H] abrir
    y cerrar esta lista de controles sin pausar el juego\n[ESC] pausa y libera el
    cursor; dentro de los men\xFAs vuelve un paso atr\xE1s\n[Clic] capturar el cursor
    para poder mirar con el mouse\n\nVEH\xCDCULO \u2014 VISTA T\xC1CTICA\n[TAB] alternar
    entre vista FPS y vista t\xE1ctica RTS\n[WASD] panear la c\xE1mara\n[E] bajarse
    del veh\xEDculo\n[Rueda] acercar y alejar la c\xE1mara\n[H] abrir y cerrar esta
    lista de controles sin pausar el juego\n[ESC] pausa y libera el cursor; dentro
    de los men\xFAs vuelve un paso atr\xE1s\n"
